[Unit]
Description=OptCNT full web analysis API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=optcnt
Group=optcnt
WorkingDirectory=/opt/opt-cnt/current
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=NUMBA_CACHE_DIR=/opt/opt-cnt/data/numba-cache
Environment=MPLCONFIGDIR=/opt/opt-cnt/data/matplotlib-cache
Environment=OPTCNT_WEB_DIR=/opt/opt-cnt/current/web
Environment=OPTCNT_DATA_DIR=/opt/opt-cnt/data
Environment=OPTCNT_MAX_UPLOAD_MB=25
Environment=OPTCNT_MAX_BATCH_FILES=20
Environment=OPTCNT_MAX_BATCH_TOTAL_MB=200
Environment=OPTCNT_SESSION_TTL_SECONDS=1800
Environment=OPTCNT_JOB_TTL_SECONDS=3600
Environment=OPTCNT_MAX_SESSIONS=24
Environment=OPTCNT_MAX_JOBS=8
Environment=OPTCNT_JOB_WORKERS=1
Environment=OPTCNT_WORKER_LEASE_SECONDS=120
Environment=OPTCNT_WORKER_HEARTBEAT_TIMEOUT_SECONDS=20
Environment=OPTCNT_JOB_POLL_SECONDS=2
EnvironmentFile=-/etc/opt-cnt/worker-api.env
ExecStart=/opt/opt-cnt/runtime/.venv/bin/python -m uvicorn src.webapp.app:app --host 127.0.0.1 --port 8769 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=4
TimeoutStopSec=30
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/opt-cnt/data
NoNewPrivileges=true
MemoryHigh=1.5G
MemoryMax=2G
TasksMax=128

[Install]
WantedBy=multi-user.target
